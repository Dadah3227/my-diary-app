            steps {
                echo 'God is good'
            }
        }
        stage("HAHA"){
            steps {
                echo 'God is faithful'
            }
        }
        stage('Jesus'){
            steps {
                echo 'Pring His name'
            }
        }
        stage('Holy Ghost'){
            steps {
                echo 'Thank you HOly Ghost'
            }
        }
        stage('Hallelujah'){
            steps {
                echo 'Jesus is Lord'
            }
        }
    }
}